<div class="px-4 py-10 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-7xl">
    <.header>
      <%= gettext("admin.dashboard") %>
      <:subtitle><%= gettext("admin.dashboard_subtitle") %></:subtitle>
      <:actions>
        <.link
          navigate={~p"/admin/rss-utility"}
          class="text-sm font-semibold text-blue-600 hover:text-blue-700"
        >
          <%= gettext("admin.rss_utility") %> <span aria-hidden="true">&rarr;</span>
        </.link>
      </:actions>
    </.header>
    <!-- Stats Cards -->
    <div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      <!-- Total Users -->
      <div class="bg-white overflow-hidden shadow rounded-lg">
        <div class="px-4 py-5 sm:p-6">
          <dt class="text-sm font-medium text-zinc-500 truncate">
            <%= gettext("admin.total_users") %>
          </dt>
          <dd class="mt-1 text-3xl font-extrabold text-zinc-900">
            <%= @stats.total_users %>
          </dd>
        </div>
      </div>
      <!-- Distinct Feeds -->
      <div class="bg-white overflow-hidden shadow rounded-lg">
        <div class="px-4 py-5 sm:p-6">
          <dt class="text-sm font-medium text-zinc-500 truncate">
            <%= gettext("admin.distinct_feeds") %>
          </dt>
          <dd class="mt-1 text-3xl font-extrabold text-zinc-900">
            <%= @stats.distinct_feeds %>
          </dd>
        </div>
      </div>
      <!-- Event Rate (Recent) -->
      <div class="bg-white overflow-hidden shadow rounded-lg">
        <div class="px-4 py-5 sm:p-6">
          <dt class="text-sm font-medium text-zinc-500 truncate">
            <%= gettext("admin.events_rate_5min") %>
          </dt>
          <dd class="mt-1 text-3xl font-extrabold text-zinc-900">
            <%= if @stats.event_rates[:recent][:events_per_minute] do %>
              <%= @stats.event_rates[:recent][:events_per_minute] %>
              <span class="text-lg font-normal text-zinc-500">/min</span>
            <% else %>
              <span class="text-lg font-normal text-zinc-500">N/A</span>
            <% end %>
          </dd>
          <dd class="mt-1 text-sm text-zinc-500">
            <%= if @stats.event_rates[:recent][:recent_events] do %>
              <%= @stats.event_rates[:recent][:recent_events] %> <%= gettext(
                "admin.events_in_5min"
              ) %>
            <% else %>
              <%= gettext("admin.no_data") %>
            <% end %>
          </dd>
        </div>
      </div>
    </div>
    <!-- Event Rates Details -->
    <div class="mt-6">
      <div class="bg-white shadow rounded-lg">
        <div class="px-4 py-5 sm:p-6">
          <h3 class="text-lg font-medium leading-6 text-zinc-900 mb-4">
            <%= gettext("admin.event_rates") %>
          </h3>

          <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
            <!-- Global Rates -->
            <div>
              <h4 class="text-sm font-semibold text-zinc-700 mb-3">
                <%= gettext("admin.global_all_time") %>
              </h4>
              <dl class="space-y-2">
                <div class="flex justify-between">
                  <dt class="text-sm text-zinc-500"><%= gettext("admin.total_events") %></dt>
                  <dd class="text-sm font-medium text-zinc-900">
                    <%= @stats.event_rates[:global][:total_events] || "N/A" %>
                  </dd>
                </div>
                <div class="flex justify-between">
                  <dt class="text-sm text-zinc-500"><%= gettext("admin.per_second") %></dt>
                  <dd class="text-sm font-medium text-zinc-900">
                    <%= @stats.event_rates[:global][:events_per_second] || "N/A" %>
                  </dd>
                </div>
                <div class="flex justify-between">
                  <dt class="text-sm text-zinc-500"><%= gettext("admin.per_minute") %></dt>
                  <dd class="text-sm font-medium text-zinc-900">
                    <%= @stats.event_rates[:global][:events_per_minute] || "N/A" %>
                  </dd>
                </div>
                <div class="flex justify-between">
                  <dt class="text-sm text-zinc-500"><%= gettext("admin.per_hour") %></dt>
                  <dd class="text-sm font-medium text-zinc-900">
                    <%= @stats.event_rates[:global][:events_per_hour] || "N/A" %>
                  </dd>
                </div>
              </dl>
            </div>
            <!-- Recent Rates -->
            <div>
              <h4 class="text-sm font-semibold text-zinc-700 mb-3">
                <%= gettext("admin.recent") %> (<%= @stats.event_rates[:recent][:period] %>)
              </h4>
              <dl class="space-y-2">
                <div class="flex justify-between">
                  <dt class="text-sm text-zinc-500"><%= gettext("admin.recent_events") %></dt>
                  <dd class="text-sm font-medium text-zinc-900">
                    <%= @stats.event_rates[:recent][:recent_events] || "N/A" %>
                  </dd>
                </div>
                <div class="flex justify-between">
                  <dt class="text-sm text-zinc-500"><%= gettext("admin.per_second") %></dt>
                  <dd class="text-sm font-medium text-zinc-900">
                    <%= @stats.event_rates[:recent][:events_per_second] || "N/A" %>
                  </dd>
                </div>
                <div class="flex justify-between">
                  <dt class="text-sm text-zinc-500"><%= gettext("admin.per_minute") %></dt>
                  <dd class="text-sm font-medium text-zinc-900">
                    <%= @stats.event_rates[:recent][:events_per_minute] || "N/A" %>
                  </dd>
                </div>
                <div class="flex justify-between">
                  <dt class="text-sm text-zinc-500"><%= gettext("admin.per_hour") %></dt>
                  <dd class="text-sm font-medium text-zinc-900">
                    <%= @stats.event_rates[:recent][:events_per_hour] || "N/A" %>
                  </dd>
                </div>
              </dl>
            </div>
          </div>
        </div>
      </div>
    </div>
    <!-- Top Podcasts -->
    <div class="mt-10">
      <h2 class="text-lg font-semibold text-zinc-900 mb-4">
        <%= gettext("admin.top_podcasts") %>
      </h2>
      <div class="bg-white shadow rounded-lg overflow-hidden">
        <table class="min-w-full divide-y divide-zinc-200">
          <thead class="bg-zinc-50">
            <tr>
              <th
                scope="col"
                class="px-6 py-3 text-left text-xs font-medium text-zinc-500 uppercase tracking-wider"
              >
                <%= gettext("admin.podcast_title") %>
              </th>
              <th
                scope="col"
                class="px-6 py-3 text-left text-xs font-medium text-zinc-500 uppercase tracking-wider"
              >
                <%= gettext("trending.score") %>
              </th>
              <th
                scope="col"
                class="px-6 py-3 text-left text-xs font-medium text-zinc-500 uppercase tracking-wider"
              >
                <%= gettext("trending.plays") %>
              </th>
              <th
                scope="col"
                class="px-6 py-3 text-left text-xs font-medium text-zinc-500 uppercase tracking-wider"
              >
                <%= gettext("trending.likes") %>
              </th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-zinc-200">
            <%= if Enum.empty?(@stats.top_podcasts) do %>
              <tr>
                <td colspan="4" class="px-6 py-4 text-center text-sm text-zinc-500">
                  <%= gettext("admin.no_podcast_data") %>
                </td>
              </tr>
            <% else %>
              <%= for podcast <- @stats.top_podcasts do %>
                <tr>
                  <td class="px-6 py-4 text-sm truncate max-w-md">
                    <div class="font-semibold text-zinc-900">
                      <%= podcast.title || gettext("common.unknown_podcast") %>
                    </div>
                    <div class="text-xs text-zinc-500 flex gap-2 mt-1">
                      <%= if podcast.website_link do %>
                        <a
                          href={podcast.website_link}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="text-blue-600 hover:underline"
                        >
                          <%= gettext("admin.website") %>
                        </a>
                      <% end %>
                      <%= if podcast.feed_url do %>
                        <a
                          href={podcast.feed_url}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="text-blue-600 hover:underline"
                        >
                          RSS Feed
                        </a>
                      <% end %>
                    </div>
                  </td>
                  <td class="px-6 py-4 text-sm font-semibold text-zinc-900">
                    <%= podcast.score %>
                  </td>
                  <td class="px-6 py-4 text-sm text-zinc-500">
                    <%= podcast.plays %>
                  </td>
                  <td class="px-6 py-4 text-sm text-zinc-500">
                    <%= podcast.likes %>
                  </td>
                </tr>
              <% end %>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
    <!-- Top Episodes -->
    <div class="mt-10">
      <h2 class="text-lg font-semibold text-zinc-900 mb-4">
        <%= gettext("admin.top_episodes") %>
      </h2>
      <div class="bg-white shadow rounded-lg overflow-hidden">
        <table class="min-w-full divide-y divide-zinc-200">
          <thead class="bg-zinc-50">
            <tr>
              <th
                scope="col"
                class="px-6 py-3 text-left text-xs font-medium text-zinc-500 uppercase tracking-wider"
              >
                <%= gettext("admin.episode_title") %>
              </th>
              <th
                scope="col"
                class="px-6 py-3 text-left text-xs font-medium text-zinc-500 uppercase tracking-wider"
              >
                <%= gettext("trending.score") %>
              </th>
              <th
                scope="col"
                class="px-6 py-3 text-left text-xs font-medium text-zinc-500 uppercase tracking-wider"
              >
                <%= gettext("trending.plays") %>
              </th>
              <th
                scope="col"
                class="px-6 py-3 text-left text-xs font-medium text-zinc-500 uppercase tracking-wider"
              >
                <%= gettext("trending.likes") %>
              </th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-zinc-200">
            <%= if Enum.empty?(@stats.top_episodes) do %>
              <tr>
                <td colspan="4" class="px-6 py-4 text-center text-sm text-zinc-500">
                  <%= gettext("admin.no_episode_data") %>
                </td>
              </tr>
            <% else %>
              <%= for episode <- @stats.top_episodes do %>
                <tr>
                  <td class="px-6 py-4 text-sm truncate max-w-md">
                    <div class="font-semibold text-zinc-900">
                      <%= episode.title || gettext("common.unknown_episode") %>
                    </div>
                    <%= if episode.podcast_title do %>
                      <div class="text-xs text-zinc-600 mt-1">
                        <%= gettext("trending.from") %>
                        <strong><%= episode.podcast_title %></strong>
                      </div>
                    <% end %>
                    <%= if episode.guid do %>
                      <div class="text-xs text-zinc-400 mt-1 font-mono truncate">
                        <%= episode.guid %>
                      </div>
                    <% end %>
                    <div class="text-xs text-zinc-500 flex gap-2 mt-2">
                      <%= if episode.episode_link do %>
                        <a
                          href={episode.episode_link}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="text-blue-600 hover:underline"
                        >
                          <%= gettext("admin.episode_link") %>
                        </a>
                      <% end %>
                      <%= if episode.feed_url do %>
                        <a
                          href={episode.feed_url}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="text-blue-600 hover:underline"
                        >
                          RSS Feed
                        </a>
                      <% end %>
                    </div>
                  </td>
                  <td class="px-6 py-4 text-sm font-semibold text-zinc-900">
                    <%= episode.score %>
                  </td>
                  <td class="px-6 py-4 text-sm text-zinc-500">
                    <%= episode.plays %>
                  </td>
                  <td class="px-6 py-4 text-sm text-zinc-500">
                    <%= episode.likes %>
                  </td>
                </tr>
              <% end %>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
