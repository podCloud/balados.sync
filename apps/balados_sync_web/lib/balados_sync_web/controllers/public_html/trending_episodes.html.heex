<div class="px-4 py-10 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-5xl">
    <h1 class="text-4xl font-bold text-zinc-900"><%= gettext("trending.episodes.title") %></h1>
    <p class="text-zinc-600 mt-2"><%= gettext("trending.episodes.subtitle") %></p>

    <div class="mt-10 space-y-4">
      <%= for {episode, index} <- Enum.with_index(@episodes, 1) do %>
        <div class="bg-white shadow rounded-lg p-6 flex gap-6">
          <!-- Rank Badge -->
          <div class="flex-shrink-0">
            <div class="w-12 h-12 rounded-full bg-green-600 text-white flex items-center justify-center text-xl font-bold">
              <%= index %>
            </div>
          </div>
          <!-- Content -->
          <div class="flex-1">
            <.link
              navigate={~p"/episodes/#{episode.rss_source_item}"}
              class="text-lg font-semibold text-blue-600 hover:text-blue-700"
            >
              <%= episode.item_title || gettext("common.unknown_episode") %>
            </.link>
            <p class="text-sm text-zinc-600 mt-1">
              <%= gettext("trending.from") %>:
              <span class="font-medium">
                <%= episode.feed_title || gettext("common.unknown_podcast") %>
              </span>
            </p>

            <div class="flex gap-6 mt-2 text-sm text-zinc-600">
              <span>
                <%= gettext("trending.score") %>:
                <span class="font-semibold"><%= episode.score %></span>
              </span>
              <span>
                <%= gettext("trending.plays") %>:
                <span class="font-semibold"><%= episode.plays %></span>
              </span>
              <span>
                <%= gettext("trending.likes") %>:
                <span class="font-semibold"><%= episode.likes %></span>
              </span>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
