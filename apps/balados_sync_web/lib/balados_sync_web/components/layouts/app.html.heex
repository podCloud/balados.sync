<% current_path = BaladosSyncWeb.LayoutHelpers.current_path(assigns) %>
<% current_params = BaladosSyncWeb.LayoutHelpers.current_params(assigns) %>
<header class="px-4 sm:px-6 lg:px-8">
  <div class="flex items-center justify-between border-b border-zinc-100 py-3 text-sm">
    <div class="flex items-center gap-4">
      <a href="/">
        <img src={~p"/images/logo.svg"} width="36" alt="Balados Sync" />
      </a>
      <p class="text-brand font-semibold leading-6">
        Balados Sync
      </p>
    </div>
    <div class="flex items-center gap-4 font-semibold leading-6 text-zinc-900">
      <% current_locale = Gettext.get_locale(BaladosSyncWeb.Gettext) %>
      <% base_params = Map.drop(current_params, ["_csrf_token", "locale"]) %>
      <nav class="flex items-center gap-1 text-xs" aria-label={gettext("nav.language_selector")}>
        <%= if current_locale == "fr" do %>
          <span class="font-bold text-blue-600" aria-current="true" lang="fr">FR</span>
        <% else %>
          <a
            href={"?#{URI.encode_query(Map.put(base_params, "locale", "fr"))}"}
            class="hover:text-zinc-700"
            lang="fr"
          >
            FR
          </a>
        <% end %>
        <span class="text-zinc-300" aria-hidden="true">|</span>
        <%= if current_locale == "en" do %>
          <span class="font-bold text-blue-600" aria-current="true" lang="en">EN</span>
        <% else %>
          <a
            href={"?#{URI.encode_query(Map.put(base_params, "locale", "en"))}"}
            class="hover:text-zinc-700"
            lang="en"
          >
            EN
          </a>
        <% end %>
      </nav>
      <.link
        navigate={~p"/trending/podcasts"}
        class={BaladosSyncWeb.LayoutHelpers.nav_link_class(current_path, "/trending")}
      >
        <%= gettext("nav.discover") %>
      </.link>
      <%= if @current_user do %>
        <span class="text-zinc-600">
          <%= @current_user.email %>
        </span>
        <.link
          navigate={~p"/dashboard"}
          class={BaladosSyncWeb.LayoutHelpers.nav_link_class(current_path, "/dashboard")}
        >
          <%= gettext("nav.dashboard") %>
        </.link>
        <.link
          navigate={~p"/subscriptions"}
          class={BaladosSyncWeb.LayoutHelpers.nav_link_class(current_path, "/subscriptions")}
        >
          <%= gettext("nav.subscriptions") %>
        </.link>
        <.link
          navigate={~p"/privacy-manager"}
          class={BaladosSyncWeb.LayoutHelpers.nav_link_class(current_path, "/privacy-manager")}
        >
          <%= gettext("nav.privacy") %>
        </.link>
        <%= if BaladosSyncWeb.Accounts.admin?(@current_user) do %>
          <.link
            navigate={~p"/admin"}
            class={BaladosSyncWeb.LayoutHelpers.nav_link_class(current_path, "/admin")}
          >
            <%= gettext("nav.admin") %>
          </.link>
        <% end %>
        <.link
          href={~p"/users/log_out"}
          method="delete"
          class="rounded-lg bg-zinc-100 px-2 py-1 hover:bg-zinc-200/80"
        >
          <%= gettext("nav.log_out") %>
        </.link>
      <% else %>
        <.link navigate={~p"/users/register"} class="hover:text-zinc-700">
          <%= gettext("nav.register") %>
        </.link>
        <.link
          navigate={~p"/users/log_in"}
          class="rounded-lg bg-zinc-100 px-2 py-1 hover:bg-zinc-200/80"
        >
          <%= gettext("nav.log_in") %> <span aria-hidden="true">&rarr;</span>
        </.link>
      <% end %>
    </div>
  </div>
</header>
<main class="px-4 py-20 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-2xl">
    <.flash_group flash={@flash} />
    <%= @inner_content %>
  </div>
</main>
